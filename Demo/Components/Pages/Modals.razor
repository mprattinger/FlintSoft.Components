@page "/modals"
@using FlintSoft.Components.Modals

<PageTitle>Modals - FlintSoft</PageTitle>
<div class="demo-eyebrow">COMPONENTS / 03</div>
<h1>A moment of focus.<br /><span>Without the noise.</span></h1>
<p class="demo-lead">Use direct modal callbacks when needed, or wrap a modal and await a typed result.</p>
<FsPanel Title="Wrapper component + awaitable open" Description="Open with existing data (or null for new) and await a result." Badge="REQUEST / RESPONSE">
    <div class="demo-actions demo-bottom-space">
        <FsButton OnClick="CreateProjectAsync">New project</FsButton>
        @if (_projects.Count > 0)
        {
            <FsButton OnClick="DeleteProjectsAsync">Project löschen</FsButton>
        }
    </div>
    <FsTable TItem="ProjectRow" Items="_projects" Columns="_columns" Caption="Projects" RowKey="project => project.Id">
        <EmptyContent>No projects yet.</EmptyContent>
    </FsTable>
    <p class="demo-muted" role="status">@_status</p>
</FsPanel>
<ProjectEditorModal @ref="_editor" />
<FsYesNoModal @ref="_yesno" />
<div class="demo-code"><span>WRAPPER FLOW</span><pre><code>var created = await editor.OpenAsync(null);
var updated = await editor.OpenAsync(new ProjectEditorRequest(id, name, summary));</code></pre></div>

@code {
    private ProjectEditorModal _editor = default!;
    private FsYesNoModal _yesno = default!;

    private string _status = "No modal interaction yet.";
    private int _nextId = 4;
    private readonly List<ProjectRow> _projects =
    [
        new(1, "FlintSoft Design System", "Token refresh and docs polish"),
        new(2, "Billing Portal", "Role-based settings and invoice export"),
        new(3, "Operations Board", "Queue overview with keyboard shortcuts")
    ];
    private IReadOnlyList<FsColumn<ProjectRow>> _columns = [];

    protected override void OnInitialized()
    {
        _columns =
        [
            new("Name", project => @<strong>@project.Name</strong>),
            new("Summary", project => @<span>@project.Summary</span>),
            new("Actions", project => @<FsButton Appearance="FsAppearance.Action" OnClick="() => EditProjectAsync(project)">Edit</FsButton>)
        ];
    }

    private async Task CreateProjectAsync()
    {
        var result = await _editor.OpenAsync();
        if (result is null)
        {
            _status = "Create canceled.";
            return;
        }

        var id = _nextId++;
        _projects.Add(new ProjectRow(id, result.Name, result.Summary));
        _status = $"Created \"{result.Name}\".";
    }

    private async Task EditProjectAsync(ProjectRow project)
    {
        var result = await _editor.OpenAsync(new ProjectEditorRequest(project.Id, project.Name, project.Summary));
        if (result is null)
        {
            _status = $"Edit canceled for \"{project.Name}\".";
            return;
        }

        var index = _projects.FindIndex(row => row.Id == project.Id);
        if (index >= 0)
        {
            _projects[index] = new ProjectRow(project.Id, result.Name, result.Summary);
            _status = $"Updated \"{result.Name}\".";
        }
    }

    private async Task DeleteProjectsAsync()
    {
        var result = await _yesno.Open(title: "Delete all projects?", "Are you sure you want to delete all projects? This action cannot be undone.", yesText: builder => builder.AddContent(0, "Delete"), noText: builder => builder.AddContent(0, "Cancel"));
        if (result)
        {
            _projects.Clear();
            _status = "Deleted all projects.";
        }
        else
        {
            _status = "Delete canceled.";
        }
    }

    private sealed record ProjectRow(int Id, string Name, string Summary);
}
