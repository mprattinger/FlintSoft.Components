<FsModal @ref="_modal" Title="Pick a contact" Style="height: min(38rem, calc(100dvh - 2rem))">
    <div class="ll-modal-body">
        <div class="ll-filter">
            <FsText Label="Filter contacts" Value="@_filter" ValueExpression="() => _filter"
                    UpdateOnInput="true" ValueChanged="v => _filter = v ?? string.Empty" />
        </div>
        <div class="ll-list">
            <FsTable TItem="ContactRow" Items="Filtered" Columns="_columns" />
        </div>
    </div>
</FsModal>

<style>
    .ll-modal-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .ll-filter {
        flex: 0 0 auto;
    }

    .ll-list {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .ll-list .fs-table-container,
    .ll-list .fs-table-scroll {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }
</style>

@code {
    private FsModal _modal = default!;
    private string _filter = string.Empty;
    private IReadOnlyList<FsColumn<ContactRow>> _columns = [];

    private static readonly IReadOnlyList<ContactRow> All =
    [
        new(1,  "Alex Morgan",      "Vienna",     "Engineering"),
        new(2,  "Jamie Lee",        "Berlin",     "Design"),
        new(3,  "Sam Kim",          "Vienna",     "Operations"),
        new(4,  "Robin Taylor",     "London",     "Engineering"),
        new(5,  "Casey Jordan",     "Paris",      "Design"),
        new(6,  "Morgan Blake",     "Madrid",     "Finance"),
        new(7,  "Dana Ellis",       "Rome",       "Engineering"),
        new(8,  "Quinn Reeves",     "Amsterdam",  "Operations"),
        new(9,  "Riley Shaw",       "Lisbon",     "Design"),
        new(10, "Jordan Price",     "Vienna",     "Finance"),
        new(11, "Avery Stone",      "Berlin",     "Engineering"),
        new(12, "Cameron Ford",     "London",     "Design"),
        new(13, "Hayden Cruz",      "Barcelona",  "Operations"),
        new(14, "Peyton Bell",      "Brussels",   "Finance"),
        new(15, "Skyler Grant",     "Prague",     "Engineering"),
        new(16, "Finley Hayes",     "Warsaw",     "Design"),
        new(17, "Rowan Simmons",    "Budapest",   "Operations"),
        new(18, "Emerson Webb",     "Vienna",     "Finance"),
        new(19, "Reese Coleman",    "Zurich",     "Engineering"),
        new(20, "Logan Murphy",     "Dublin",     "Design"),
    ];

    private IReadOnlyList<ContactRow> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? All
            : All.Where(c =>
                c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                c.City.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                c.Department.Contains(_filter, StringComparison.OrdinalIgnoreCase))
              .ToList();

    protected override void OnInitialized()
    {
        _columns =
        [
            new("Name",       c => @<strong>@c.Name</strong>,       Width: "10rem"),
            new("City",       c => @<span>@c.City</span>,           Width: "8rem"),
            new("Department", c => @<span>@c.Department</span>),
        ];
    }

    public Task OpenAsync() => _modal.OpenAsync();

    private sealed record ContactRow(int Id, string Name, string City, string Department);
}
