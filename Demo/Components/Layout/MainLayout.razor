@inherits LayoutComponentBase

<div class="demo-shell" data-fs-theme="@(_dark ? "dark" : "light")" data-interactive="@_interactive.ToString().ToLowerInvariant()">
    <a class="demo-skip" href="#main">Skip to content</a>
    <aside class="demo-sidebar">
        <a class="demo-brand" href=""><span class="demo-mark" aria-hidden="true">f.</span><span>FlintSoft<span class="demo-brand-sub">COMPONENTS</span></span></a>
        <div class="demo-version"><span class="demo-dot"></span> v2.0 preview <span>.NET 10</span></div>
        <NavMenu />
        <div class="demo-sidebar-note"><strong>Small details.<br />Better interfaces.</strong><p>Native Blazor. Thoughtfully styled.</p></div>
    </aside>
    <div class="demo-workspace">
        <header class="demo-topbar">
            <span>Component library <span class="demo-topbar-divider">/</span> <strong>Playground</strong></span>
            <button class="demo-theme" @onclick="() => _dark = !_dark" aria-pressed="@_dark" aria-label="Toggle dark theme">
                <span aria-hidden="true">@(_dark ? "◐" : "◑")</span> @(_dark ? "Dark" : "Light") theme
            </button>
        </header>
        <main id="main" class="demo-main">@Body</main>
        <footer class="demo-footer"><span>FlintSoft.Components</span><span>Built for Blazor. Designed for everyone.</span></footer>
    </div>
    <FsToastHost />
</div>
<div id="blazor-error-ui">An unexpected error occurred. <a href="">Reload</a><button class="dismiss" aria-label="Dismiss error">&#215;</button></div>

@code {
    private bool _dark;
    private bool _interactive;
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        StateHasChanged();
    }
}
