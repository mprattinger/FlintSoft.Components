@inherits MyComponentBase

@* <div @ref="Element" id="@GetId()" class="@ClassValue" style="@StyleValue">
    @ChildContent
</div> *@

<div @ref="Element"
     id="@GetId()"
     class="@ClassValue"
     style="@StyleValue"
     data-label="@Label">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Label { get; set; }

    protected override string ClassValue => $"col {Class}".Trim();

    protected override string StyleValue => $"{Style}".Trim();
}
