@inherits MyComponentBase

<div @ref="Element" id="@GetId()" class="@ClassValue" style="@StyleValue" @onclick="OnClickHandler">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsHeaderRow { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    protected override string ClassValue => $"row {(IsHeaderRow ? "header" : "")} {Class}".Trim();

    protected override string StyleValue => $"{Style}".Trim();

    void OnClickHandler(MouseEventArgs e)
    {
        if (OnClick.HasDelegate)
        {
            OnClick.InvokeAsync(e);
        }
    }
}
