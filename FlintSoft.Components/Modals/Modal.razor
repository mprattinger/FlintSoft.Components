@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="overlay">
        <div class="container" style="@ModalStyle">
            <div class="close-btn">
                @if (HasCloseButton)
                {
                    <Cross OnClicked="OnClose" />
                }
            </div>
            <div class="header">
                <h3>@Title</h3>
            </div>
            <div class="body">
                @ChildContent
            </div>
            @if (Footer != null)
            {
                <div class="footer">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    private IJSObjectReference? modalModule;
    private bool isBodyScrollLocked;

    [Parameter, EditorRequired]
    public bool IsVisible { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public string ModalStyle { get; set; } = "";

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool HasCloseButton { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            modalModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/FlintSoft.Components/Modals/Modal.razor.js");
        }

        if (modalModule is null)
        {
            return;
        }

        if (IsVisible && !isBodyScrollLocked)
        {
            await modalModule.InvokeVoidAsync("lockBodyScroll");
            isBodyScrollLocked = true;
            return;
        }

        if (!IsVisible && isBodyScrollLocked)
        {
            await modalModule.InvokeVoidAsync("unlockBodyScroll");
            isBodyScrollLocked = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (modalModule != null && isBodyScrollLocked)
            {
                await modalModule.InvokeVoidAsync("unlockBodyScroll");
            }
        }
        catch
        {
        }
    }
}
