@namespace FlintSoft.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="fs-context-menu @(_expanded ? "fs-context-menu-open" : null) @Class" @attributes="AdditionalAttributes">
    <button type="button" class="fs-context-menu-trigger"
            aria-label="@TriggerLabel" aria-expanded="@_expanded.ToString().ToLowerInvariant()"
            aria-controls="@_flyoutId" @onclick="Toggle">
        @if (Icon is not null)
        {
            <span class="fs-context-menu-icon" aria-hidden="true">@Icon</span>
        }
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            @Text
        }
        else if (Icon is null)
        {
            @TriggerLabel
        }
    </button>
    @if (_expanded)
    {
        <section id="@_flyoutId" class="fs-context-menu-flyout @AlignmentClass" aria-label="@TriggerLabel">
            @ChildContent
        </section>
    }
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public FsContextMenuAlignment Alignment { get; set; } = FsContextMenuAlignment.Default;
    [Parameter] public bool CloseOnContentClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? AlignmentClass => Alignment switch
    {
        FsContextMenuAlignment.Default => null,
        FsContextMenuAlignment.Left => "fs-context-menu-flyout-left",
        FsContextMenuAlignment.Center => "fs-context-menu-flyout-center",
        FsContextMenuAlignment.Right => "fs-context-menu-flyout-right",
        _ => throw new ArgumentOutOfRangeException(nameof(Alignment), Alignment, "Unknown context menu alignment.")
    };
    private string TriggerLabel => !string.IsNullOrWhiteSpace(AccessibleLabel) ? AccessibleLabel
        : !string.IsNullOrWhiteSpace(Text) ? Text : "Actions";
    private readonly string _flyoutId = $"fs-context-menu-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FsContextMenu>? _reference;
    private bool _expanded;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FlintSoft.Components/flintsoft.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attachContextMenu", _root, _reference, CloseOnContentClick);
        }
        if (_expanded && !_disposed && _module is not null)
            await _module.InvokeVoidAsync("positionContextMenu", _root);
    }

    private void Toggle() => _expanded = !_expanded;

    [JSInvokable]
    public Task DismissContextMenuAsync()
    {
        if (_disposed || !_expanded) return Task.CompletedTask;
        _expanded = false;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detachContextMenu", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser removes listeners when the context menu leaves the DOM.
            }
        }
        _reference?.Dispose();
    }
}
