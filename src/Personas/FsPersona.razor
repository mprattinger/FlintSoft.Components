@namespace FlintSoft.Components
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="fs-persona @Class" @attributes="AdditionalAttributes">
    <button type="button" class="fs-persona-avatar" aria-label="@(Name ?? AccessibleLabel)"
            aria-expanded="@_expanded.ToString().ToLowerInvariant()" aria-controls="@_cardId"
            @onclick="Toggle">
        @if (!string.IsNullOrWhiteSpace(ImageUrl) && !_imageFailed)
        {
            <img src="@ImageUrl" alt="" @onerror="() => _imageFailed = true" />
        }
        else
        {
            <span aria-hidden="true">@DisplayInitials</span>
        }
    </button>
    @if (_expanded)
    {
        <section id="@_cardId" class="fs-persona-card" aria-label="@(Name ?? AccessibleLabel)">
            @if (Name is not null || Description is not null)
            {
                <div class="fs-persona-heading">
                    @if (Name is not null)
                    {
                        <strong>@Name</strong>
                    }
                    @if (Description is not null)
                    {
                        <p>@Description</p>
                    }
                </div>
            }
            @if (ChildContent is not null)
            {
                <div class="fs-persona-details">@ChildContent</div>
            }
            @if (Actions is not null)
            {
                <div class="fs-persona-actions">@Actions</div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Initials { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string AccessibleLabel { get; set; } = "User profile";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _cardId = $"fs-persona-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FsPersona>? _reference;
    private string? _previousImageUrl;
    private bool _imageFailed;
    private bool _expanded;
    private bool _disposed;

    private string DisplayInitials
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Initials)) return Initials;
            var words = Name?.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
            if (words is not { Length: > 0 }) return "?";
            var first = StringInfo.GetNextTextElement(words[0]);
            return (words.Length == 1 ? first : first + StringInfo.GetNextTextElement(words[^1])).ToUpperInvariant();
        }
    }

    protected override void OnParametersSet()
    {
        if (_previousImageUrl == ImageUrl) return;
        _previousImageUrl = ImageUrl;
        _imageFailed = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FlintSoft.Components/flintsoft.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attachPersona", _root, _reference);
        }
        if (_expanded && !_disposed && _module is not null)
            await _module.InvokeVoidAsync("positionPersona", _root);
    }

    private void Toggle() => _expanded = !_expanded;

    [JSInvokable]
    public Task DismissPersonaAsync()
    {
        if (_disposed || !_expanded) return Task.CompletedTask;
        _expanded = false;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detachPersona", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser removes listeners when the persona leaves the DOM.
            }
        }
        _reference?.Dispose();
    }
}
